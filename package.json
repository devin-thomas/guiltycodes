{
  "name": "guiltycodes",
  "version": "1.0.0",
  "description": "Guilty Codes: cheat codes for the Guilty Gear PS2 games",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node tools/check-style.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "npm run typecheck && node build.ts",
    "deploy": "npm run check && npm run build && wrangler pages deploy dist --project-name guiltycodes --branch main"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@uppercut-labs/dreamcast-backgrounds": "0.1.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "marked": "18.1.1",
    "yaml": "2.9.1"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/three": "0.183.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "simple-icons": "16.35.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
