patch=1,EE,00010001,extended,00000000
patch=1,EE,1032162C,extended,00000001

[Max play time]
author=retro-graphics-research
description=Play time 60000 minutes; the play-time check grants the time-released unlocks (same write as Fullcodes' "Have All Characters' color", GameHacking.org 103881).
patch=1,EE,203215E0,extended,0000EA60

